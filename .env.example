# Copy this file to .env.local (git-ignored) and fill it in. Never commit real values.
# The same three variables must also be added in Vercel → Project Settings → Environment Variables.

# The SAME MongoDB Atlas connection string the customer site (orzino) uses — this dashboard
# reads and writes the same database, just from a separate app/deployment.
MONGODB_URI="mongodb+srv://<db-user>:<db-password>@<cluster-host>.mongodb.net/?retryWrites=true&w=majority"

# Same database name as the customer site.
MONGODB_DB="orzino"

# A DIFFERENT secret from the customer site's AUTH_SECRET — these are two separate apps, so
# an admin session token and a customer session token should never be signed with the same key.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# Optional, local development only (ignored in production): skip rate limiting while you test.
# RATE_LIMIT_DISABLED="true"
